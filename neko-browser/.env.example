# Browser image: firefox | chromium | google-chrome | brave | microsoft-edge
# (google-chrome and microsoft-edge images are x86_64 only; use firefox/chromium on ARM)
BROWSER=firefox

# Virtual screen size and frame rate: WIDTHxHEIGHT@FPS
SCREEN=1280x720@30

# Password viewers use to join (setup.sh generates a random one)
USER_PASSWORD=changeme-user

# Password for admins (can control session, kick users, etc.)
ADMIN_PASSWORD=changeme-admin

# Public IP of this server, advertised to WebRTC clients (setup.sh auto-detects)
PUBLIC_IP=

# Optional domain for automatic HTTPS via Caddy (leave empty for plain HTTP on :8080)
DOMAIN=
